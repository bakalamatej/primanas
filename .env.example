# PostgreSQL connection (copy this file to .env and fill in your values)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=your_database
PGUSER=teamcore_reader
PGPASSWORD=replace_with_a_strong_password
PGSCHEMA=public

# Optional: comma-separated allowlist. Defaults to the tables shown in your ERD.
PGTABLES=processes,events,images,processes_tags,label_metadata

# Alternative: use one URL instead of PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD
# DATABASE_URL=postgresql+psycopg://teamcore_reader:password@127.0.0.1:5432/your_database
